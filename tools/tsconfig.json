{
  // Everything the node side runs, checked under one strict configuration:
  // the trusted front end, the suites and the development tools in dev/.
  // `isolatedDeclarations` (with `declaration`, emitting nothing under
  // `noEmit`): an export's type is determined by its own syntax.
  "compilerOptions": {
    "target": "es2022",
    "module": "preserve",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "declaration": true,
    "isolatedDeclarations": true,
    "strict": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "lib": ["es2022"],
    "types": ["node"]
  },
  "include": ["*.mts", "../tests/*.mts", "../pipeline/*.mts", "../dev/*.mts"]
}
