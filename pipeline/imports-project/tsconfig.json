{
  // A library module the value-import examples resolve through `paths`.
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "module": "Node16",
    "moduleResolution": "Node16",
    "target": "ES2022",
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "paths": {
      "@fixture/lib": ["./lib.ts"],
      "@fixture/relay": ["./relay.ts"],
      "@fixture/whole": ["./whole.ts"]
    }
  },
  "include": [
    "../examples/*value-import*.ts",
    "./lib.ts",
    "./relay.ts",
    "./whole.ts"
  ]
}
