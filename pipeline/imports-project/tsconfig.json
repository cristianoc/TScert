{
  // A library module the value-import examples resolve through `paths`.
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "module": "Node16",
    "moduleResolution": "Node16",
    "target": "ES2022",
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "paths": {
      "@fixture/lib": ["./lib.ts"],
      "@fixture/certified": ["./certified.ts"],
      "@fixture/scaled": ["./scaled.mts"],
      "@fixture/outer": ["./outer.ts"],
      "@fixture/ping": ["./ping.ts"],
      "@fixture/pong": ["./pong.ts"],
      "@fixture/relay": ["./relay.ts"],
      "@fixture/whole": ["./whole.ts", "./defaulted.ts"],
      "@fixture/defaulted": ["./defaulted.ts"],
      "@fixture/defaulted-key": ["./defaulted-key.ts"]
    }
  },
  "include": [
    "../examples/*value-import*.ts",
    "./lib.ts",
    "./certified.ts",
    "./scaled.mts",
    "./outer.ts",
    "./ping.ts",
    "./pong.ts",
    "./relay.ts",
    "./whole.ts",
    "./defaulted.ts",
    "./defaulted-key.ts",
    "./generated-names.d.ts"
  ]
}
