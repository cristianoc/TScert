{
  // A library module the value-import examples resolve through `paths`.
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "module": "Node16",
    "moduleResolution": "Node16",
    "target": "ES2022",
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "paths": {
      "@fixture/lib": ["./lib.ts"],
      "@fixture/certified": ["./certified.ts"],
      "@fixture/early": ["./early.ts"],
      "@fixture/counter": ["./counter.ts"],
      "@fixture/cell-left": ["./cell-left.ts"],
      "@fixture/cell-right": ["./cell-right.ts"],
      "@fixture/scaled": ["./scaled.mts"],
      "@fixture/outer": ["./outer.ts"],
      "@fixture/ping": ["./ping.ts"],
      "@fixture/pong": ["./pong.ts"],
      "@fixture/relay": ["./relay.ts"],
      "@fixture/whole": ["./whole.ts", "./defaulted.ts"],
      "@fixture/defaulted": ["./defaulted.ts"],
      "@fixture/defaulted-key": ["./defaulted-key.ts"],
      "@fixture/default-function": ["./default-function.ts"],
      "@fixture/grades": ["./grades.ts"],
      "@fixture/grades-relay": ["./grades-relay.ts"],
      "@fixture/stated": ["./stated.ts"],
      "@fixture/stated-overload": ["./stated-overload.ts"],
      "@fixture/partial": ["./partial.ts"],
      "@fixture/partial-init": ["./partial-init.ts"],
      "@fixture/failures": ["./failures.ts"],
      "@fixture/failures-relay": ["./failures-relay.ts"],
      "@fixture/failures-rebound": ["./failures-rebound.ts"],
      "@fixture/failures-ambient-base": ["./failures-ambient-base.ts"]
    }
  },
  "include": [
    "../examples/*value-import*.ts",
    "./lib.ts",
    "./certified.ts",
    "./early.ts",
    "./counter.ts",
    "./cell-left.ts",
    "./cell-right.ts",
    "./scaled.mts",
    "./outer.ts",
    "./ping.ts",
    "./pong.ts",
    "./relay.ts",
    "./default-function.ts",
    "./whole.ts",
    "./defaulted.ts",
    "./defaulted-key.ts",
    "./generated-names.d.ts",
    "./grades.ts",
    "./grades-relay.ts",
    "./grades-ambient.d.ts",
    "./stated.ts",
    "./stated-overload.ts",
    "./stated-ambient.d.ts",
    "./hooks-ambient.d.ts",
    "./partial.ts",
    "./partial-init.ts",
    "./failures.ts",
    "./failures-relay.ts",
    "./failures-rebound.ts",
    "./failures-ambient.d.ts",
    "./failures-ambient-base.ts",
    "../../tools/resolvable.d.ts"
  ]
}
