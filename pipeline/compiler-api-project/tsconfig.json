{
  // The compiler-API examples import the host package `typescript`, the one
  // the front end pins (tools/package-lock.json), through the installation
  // link `../examples/node_modules` (pipeline/fixture-links.mts), as Node
  // does; inside the package its own `imports` map resolves `#enums/*`. One
  // path, `typescript/unstable/other`, points TypeScript at the guards'
  // declarations without redirecting Node (`invalid-compiler-api-guard-subpath`).
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "module": "preserve",
    "moduleResolution": "bundler",
    "target": "es2022",
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": [],
    "paths": {
      "typescript/unstable/other": [
        "../../tools/node_modules/typescript/dist/ast/index.d.ts"
      ],
      "@fixture/node-names": ["./node-names.ts"],
      "@fixture/node-types": ["./node-types.ts"]
    }
  },
  "include": ["../examples/*compiler-api*.ts", "./node-names.ts", "./node-types.ts"]
}
