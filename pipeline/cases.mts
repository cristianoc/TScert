// Executable coverage inventory. Each control names its intended boundary.
// A newly earlier refusal of an existing control is a gap, not evidence that
// its original validation obligation was checked.
//
// The value-import cases name `imports-project` as their project:
// imports-project/lib.ts is the library they import, assumed at its declared types;
// imports-project/relay.ts re-exports one of its values under another name;
// imports-project/tsconfig.json resolves `@fixture/lib` and `@fixture/relay` to them through `paths`;
// imports-project/package.json makes it an ES module, as that project's Node16 resolution requires.
import type { Outcome, Phase } from "./verify-source.mts";
export interface Case {
  file: string;
  area: string;
  kind: "positive" | "negative" | "gap";
  status: Outcome["status"];
  phase: Phase;
  diagnostic?: RegExp;
  /** Source tree supplying named imports. */
  project?: string;
  /** Whether a failed search is named by TypeScript's errors
   * (`verify-source.mts --typescript-errors`). */
  typescriptErrors?: boolean;
  /** Source fragments at which a diagnostic run must retain a refusal. */
  diagnosticSites?: string[];
}
const positive = (file: string, area: string): Case => ({
  file,
  area,
  kind: "positive",
  status: "verified",
  phase: "check",
});
const negative = (
  file: string,
  area: string,
  diagnostic: RegExp = /evidence search failed/,
): Case => ({
  file,
  area,
  kind: "negative",
  status: "unverified",
  phase: "search",
  diagnostic,
});
const gap = (
  file: string,
  area: string,
  status: Outcome["status"],
