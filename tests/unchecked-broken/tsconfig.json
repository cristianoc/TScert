{
  // A project tools/unchecked.mts must refuse: an external declaration in it
  // does not check (test-all.sh).
  "compilerOptions": {
    "target": "es2022",
    "module": "preserve",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "lib": ["es2022"],
    "types": []
  },
  "include": ["*.mts"]
}
